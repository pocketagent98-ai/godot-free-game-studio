; Engine configuration file.
; Turbo Rush — 3D level-based arcade racing game (Godot 4.7+).

config_version=5

[application]

config/name="Turbo Rush"
config/description="3D level-based arcade racing with garage, customization and 1000+ levels."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameData="*res://src/autoload/GameData.gd"
SaveManager="*res://src/autoload/SaveManager.gd"
Economy="*res://src/autoload/Economy.gd"
Progression="*res://src/autoload/Progression.gd"
Ads="*res://src/autoload/Ads.gd"
Audio="*res://src/autoload/Audio.gd"
Game="*res://src/autoload/Game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

steer_left={
"deadzone": 0.2,
